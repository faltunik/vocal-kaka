# Client-side configuration (safe to expose - the anon key is RLS-scoped)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Server-side secrets. NEVER prefix these with EXPO_PUBLIC_.
# Store them in Supabase Vault (recommended) or as Edge Function secrets:
#   select vault.create_secret('<value>', 'groq_api_key');
#   npx supabase secrets set MODEL_API_KEY=<value>
# ------------------------------------------------------------------------------
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MODEL_API_KEY=

# Meta transport: openrouter | direct | off   (unset = auto)
# META_TRANSPORT=openrouter

# Kill switch for the Meta tier
# META_MODE=off
