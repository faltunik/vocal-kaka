{
  "expo": {
    "name": "vocal-stock-mobile",
    "slug": "vocal-stock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vocalstockmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocalstock.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VocalStock needs microphone access to listen for inventory commands.",
        "NSCameraUsageDescription": "VocalStock needs camera access to scan inventory shelves."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.vocalstock.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VocalStock to access your camera to scan items."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F8",
          "dark": {
            "backgroundColor": "#F7F7F8"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b569f47-9ac4-44b5-af27-b10683bb19f4"
      }
    },
    "owner": "nikhilsannat"
  }
}
